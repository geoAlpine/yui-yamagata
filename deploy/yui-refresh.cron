# /etc/cron.d/yui-refresh
# 実データの月次更新。毎月1日の午前3時（アクセスの少ない時間帯）。
# deploy-yui として実行する。root ではない。
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
0 3 1 * * deploy-yui /var/www/yui/production/current/deploy/refresh-data.sh

# 期限切れの写真を消す。毎日4時。
# 容量対策であると同時に、写り込んだ人の顔を残し続けないための措置でもある。
0 4 * * * deploy-yui /var/www/yui/production/current/deploy/purge-photos.sh production
