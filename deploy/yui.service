# 本番: /etc/systemd/system/yui.service
[Unit]
Description=やまがた結（ゆい） 本番
After=network.target postgresql.service

[Service]
Type=simple
User=deploy-yui
WorkingDirectory=/var/www/yui/production/current
EnvironmentFile=/etc/yui/production.env
Environment=NODE_ENV=production
Environment=PORT=3010
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

# 同居している商用サイト（yukemuri-coffee.com 等）を巻き込まないための上限。
# 防災サイトが暴走しても、他のサイトのメモリとCPUは侵さない。
MemoryMax=768M
MemoryHigh=640M
CPUQuota=150%
TasksMax=256

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# 写真の保存先はアプリのツリーの外に置く。
# 中に置くと nginx（www-data）が親ディレクトリを通れず403になり、
# 権限を緩めるとアプリのソースまで読ませることになる。
# ProtectSystem=strict なので、書き込む場所は明示的に許可が要る。
ReadWritePaths=/var/www/yui/production /var/www/yui-uploads/production

[Install]
WantedBy=multi-user.target
